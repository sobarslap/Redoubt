{"id": "tool_default_allow", "category": "tools", "description": "default ALLOW tool is authorized", "params": {"tool": "query_metrics", "permission": "allow"}, "expect": {"authorized": true}}
{"id": "tool_require_approval_denied", "category": "tools", "description": "REQUIRE_APPROVAL not auto-authorized", "params": {"tool": "restart_service", "permission": "require_approval"}, "expect": {"authorized": false}}
{"id": "tool_allowlist_grants", "category": "tools", "description": "allow-list authorizes a require_approval tool", "params": {"tool": "restart_service", "permission": "require_approval", "allow": ["restart_service"]}, "expect": {"authorized": true}}
{"id": "tool_denylist_overrides", "category": "tools", "description": "deny-list overrides default ALLOW", "params": {"tool": "read_logs", "permission": "allow", "deny": ["read_logs"]}, "expect": {"authorized": false}}
{"id": "tool_permission_deny", "category": "tools", "description": "DENY permission is always refused", "params": {"tool": "drop_table", "permission": "deny"}, "expect": {"authorized": false}}
{"id": "tool_allowlist_excludes", "category": "tools", "description": "tool not on allow-list is refused", "params": {"tool": "read_logs", "permission": "allow", "allow": ["query_metrics"]}, "expect": {"authorized": false}}
{"id": "tool_operation_permitted", "category": "tools", "description": "permitted operation runs", "params": {"tool": "kv", "permission": "allow", "operations": ["read"], "operation": "read"}, "expect": {"authorized": true}}
{"id": "tool_operation_denied", "category": "tools", "description": "non-permitted operation refused", "params": {"tool": "kv", "permission": "allow", "operations": ["read"], "operation": "delete"}, "expect": {"authorized": false}}
{"id": "tool_deny_beats_allowlist", "category": "tools", "description": "deny-list beats allow-list", "params": {"tool": "restart_service", "permission": "allow", "allow": ["restart_service"], "deny": ["restart_service"]}, "expect": {"authorized": false}}
{"id": "tool_default_allow_2", "category": "tools", "description": "another default ALLOW", "params": {"tool": "read_logs", "permission": "allow"}, "expect": {"authorized": true}}
{"id": "tool_require_approval_2", "category": "tools", "description": "destructive default require_approval refused", "params": {"tool": "delete_index", "permission": "require_approval"}, "expect": {"authorized": false}}
{"id": "tool_allowlist_grants_2", "category": "tools", "description": "allow-list grants a second tool", "params": {"tool": "scale_service", "permission": "require_approval", "allow": ["scale_service"]}, "expect": {"authorized": true}}
{"id": "tool_deny_permission_2", "category": "tools", "description": "second DENY tool refused", "params": {"tool": "shutdown", "permission": "deny", "allow": ["shutdown"]}, "expect": {"authorized": false}}
{"id": "tool_operation_permitted_2", "category": "tools", "description": "write op permitted", "params": {"tool": "kv2", "permission": "allow", "operations": ["read", "write"], "operation": "write"}, "expect": {"authorized": true}}
