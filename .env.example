# Copy this file to `.env` and fill in your key. `.env` is gitignored — it is
# never committed or pushed. The demo apps load it at startup so you set the key
# once instead of re-exporting it in every terminal.
#
#   cp .env.example .env      # then edit .env and paste your key

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional — Anthropic Claude, used as the reasoning/judge role and a fallback.
# ANTHROPIC_API_KEY=
